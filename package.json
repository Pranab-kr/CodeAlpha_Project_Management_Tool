{
  "name": "codealpha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w @codealpha/server\" \"npm run dev -w @codealpha/client\"",
    "setup": "node scripts/setup.mjs",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w @codealpha/server",
    "db:migrate": "npm run db:migrate -w @codealpha/server",
    "db:seed": "npm run db:seed -w @codealpha/server",
    "db:reset": "npm run db:reset -w @codealpha/server"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.2",
    "typescript-eslint": "8.72.1"
  }
}
