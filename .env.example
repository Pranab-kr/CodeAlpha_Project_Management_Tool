NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://teamboard:teamboard@localhost:5432/teamboard
TEST_DATABASE_URL=postgres://teamboard:teamboard@localhost:5432/teamboard_test
JWT_SECRET=replace-me-with-at-least-32-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
# Set true when Express should serve apps/client/dist (production shape).
SERVE_CLIENT=false
LOG_LEVEL=info
